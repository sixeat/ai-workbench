# AI Workbench environment example
#
# Local development:
#   copy this file to .env
#   npm run dev
#
# Server deployment:
#   copy this file to .env
#   set WORKBENCH_DEPLOYMENT_MODE=server
#   npm run start:server

# Server bind settings.
# Local mode defaults to 127.0.0.1 when omitted.
# Server mode defaults to 0.0.0.0 when omitted.
PROXY_HOST=
PROXY_PORT=3000

# Frontend API base URL.
# Production frontend builds require this value.
# Use "/" only when frontend and backend intentionally share the same origin.
# Split deployment example: https://api.example.com
# Local development can omit it; the frontend then defaults to http://127.0.0.1:3000.
VITE_PROXY_URL=/

# server
# AI Workbench now uses the same login/session behavior locally and on servers.
WORKBENCH_DEPLOYMENT_MODE=server

# Optional when WORKBENCH_REQUIRE_LOGIN=true.
# Required only when login is disabled in server mode, unless WORKBENCH_ALLOW_PUBLIC_SERVER=true is set explicitly.
# This is a legacy/private API gate. Prefer email login for normal server deployments.
WORKBENCH_ACCESS_TOKEN=
# Required for admin-only actions in server mode:
# - creating/updating/deleting server-scoped API keys
# - editing global model capability rules
# If you do not set this, make sure a bootstrap admin or an existing admin user is available.
WORKBENCH_ADMIN_TOKEN=
# Keep false. Turning this on exposes paid API and compute endpoints to the public internet.
WORKBENCH_ALLOW_PUBLIC_SERVER=false

# Private multi-user login.
# Server mode defaults to login required. Keep this true for server deployments.
WORKBENCH_REQUIRE_LOGIN=true
WORKBENCH_SESSION_TTL_DAYS=14
# Cookie settings for split frontend/backend deployments.
# Same-site deployment can keep Lax. Cross-site HTTPS deployment should use:
#   WORKBENCH_COOKIE_SAMESITE=None
#   WORKBENCH_COOKIE_SECURE=true
#   WORKBENCH_COOKIE_DOMAIN=.example.com
WORKBENCH_COOKIE_SAMESITE=Lax
WORKBENCH_COOKIE_SECURE=
WORKBENCH_COOKIE_DOMAIN=
# Optional bootstrap admin account. Set both values before first server start.
# Change the password after deploying. Do not commit real credentials.
# If the database already has an enabled admin, you can leave these empty.
WORKBENCH_ADMIN_EMAIL=admin@example.com
# Optional display name. If omitted, the email is used.
WORKBENCH_ADMIN_USERNAME=admin
WORKBENCH_ADMIN_PASSWORD=change-me-before-server-use

# Email verification for registration.
# Server mode requires SMTP when public registration or invitation-based signup is enabled.
WORKBENCH_EMAIL_CODE_TTL_MINUTES=10
# Verification-code request limits. These are checked by both email and IP.
WORKBENCH_EMAIL_CODE_WINDOW_MS=3600000
WORKBENCH_EMAIL_CODE_EMAIL_LIMIT=3
WORKBENCH_EMAIL_CODE_IP_LIMIT=20
WORKBENCH_SMTP_HOST=
WORKBENCH_SMTP_PORT=587
WORKBENCH_SMTP_SECURE=false
WORKBENCH_SMTP_USER=
WORKBENCH_SMTP_PASS=
WORKBENCH_SMTP_FROM=
# Local development can expose the code in the register response.
WORKBENCH_EMAIL_DEV_CODE_VISIBLE=false
WORKBENCH_EMAIL_DEV_MODE=false

# Registration policy.
# Server default is safer: public registration off.
# Keep invitation signup off unless SMTP is configured; admins can still create users manually.
# To allow anyone with email verification to register, set:
#   WORKBENCH_ALLOW_PUBLIC_REGISTRATION=true
WORKBENCH_ALLOW_PUBLIC_REGISTRATION=false
WORKBENCH_REQUIRE_INVITATION_CODE=false

# Whether the backend trusts x-user-id / userId sent by the browser.
# Keep false. Logged-in session user id is the source of truth.
WORKBENCH_TRUST_CLIENT_USER_ID=false

# Maximum number of user-scoped API keys each account can save.
# Server-scoped keys are managed by admins and are not counted here.
WORKBENCH_MAX_USER_API_KEYS=20

# Keep false in server mode. API keys should be saved on the backend, then used by apiKeyId.
WORKBENCH_ALLOW_DIRECT_API_KEYS=false

# Static frontend serving from dist.
# Local mode defaults to true. Server mode defaults to false so the backend can run as an API service.
# Keep false in server mode. Deploy the frontend separately.
WORKBENCH_SERVE_STATIC=false

# CORS origin.
# Required when the frontend and backend are deployed on different origins.
# This must be the frontend page origin, not the backend API origin.
# Example: https://workbench.example.com
WORKBENCH_CORS_ORIGIN=

# Public API URL used when uploaded reference assets are sent to third-party model APIs.
# In split frontend/backend deployments, this should point to the backend API origin.
# Leave empty only when requests already reach the backend through its final public host.
# Example: https://api.example.com
WORKBENCH_PUBLIC_BASE_URL=

# Generic proxy is disabled by default because it can forward arbitrary requests.
# Keep it false on public servers unless you also set a strict allowlist.
WORKBENCH_ENABLE_GENERIC_PROXY=false
# Comma-separated host/origin allowlist for /api/proxy when enabled.
# Required in server mode if WORKBENCH_ENABLE_GENERIC_PROXY=true.
# Examples: api.openai.com,https://dashscope.aliyuncs.com,*.volces.com
WORKBENCH_PROXY_ALLOWLIST=

# Legacy synchronous generation endpoints.
# Keep false. Server mode always keeps /api/chat/sync, /api/images/sync,
# /api/videos/sync and /api/claude/sync unavailable so generation goes through
# queued tasks and local workers.
WORKBENCH_ENABLE_SYNC_GENERATION=false

# Basic in-memory rate limits. Increase only for trusted/private deployments.
WORKBENCH_RATE_LIMIT_WINDOW_MS=60000
WORKBENCH_EXPENSIVE_RATE_LIMIT=12
WORKBENCH_UPLOAD_RATE_LIMIT=30
WORKBENCH_PROXY_RATE_LIMIT=20

# Local worker queue concurrency.
# Text tasks are chat/script/prompt generation. Generation tasks are image/video.
# Increase carefully: higher values can spend API credits faster and hit provider limits.
WORKBENCH_TEXT_QUEUE_CONCURRENCY=2
WORKBENCH_GENERATION_QUEUE_CONCURRENCY=2

# Upload and asset storage limits.
# These limits apply to /api/assets/upload. User storage quota counts all assets.
WORKBENCH_MAX_UPLOAD_FILE_MB=20
WORKBENCH_MAX_USER_ASSET_STORAGE_MB=2048
WORKBENCH_MAX_DAILY_UPLOAD_MB=200

# Persistent storage paths.
# Use absolute paths on servers so upgrades do not lose data.
WORKBENCH_DATA_DIR=./data
WORKBENCH_DB_PATH=./data/ai-workbench.sqlite
IMAGE_OUTPUT_DIR=./outputs

# Required in server mode if API keys are stored on the server.
# Change this before real use. Keep it stable, or saved keys cannot be decrypted.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKBENCH_KEY_SECRET=replace-with-a-long-random-secret

# Optional server-managed default API credentials.
# Prefer storing keys in the UI/API key manager after setting WORKBENCH_KEY_SECRET.
WORKBENCH_SERVER_BASE_URL=
WORKBENCH_SERVER_API_KEY=
