{
  "name": "ai-workbench-backend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "节点工作流平台后端。前端在 ../frontend（独立仓库）。",
  "scripts": {
    "check:deploy": "node server/deploymentCheck.cjs",
    "check:mojibake": "node scripts/checkMojibake.cjs",
    "check:registry-sync": "node scripts/checkRegistrySync.cjs",
    "check:types": "tsc -b",
    "export:node-registry": "node --import tsx scripts/exportNodeRegistry.mjs",
    "lint": "oxlint",
    "test": "node --test server/**/*.test.cjs",
    "start": "node server/index.cjs",
    "start:api": "node server/api.cjs",
    "start:asset-service": "node server/assetService.cjs",
    "start:auth-service": "node server/authService.cjs",
    "start:all": "node server/index.cjs",
    "start:model-service": "node server/modelService.cjs",
    "start:server": "npm run check:deploy && node server/index.cjs",
    "start:worker": "node server/worker.cjs",
    "start:worker-service": "node server/workerService.cjs",
    "start:workflow-service": "node server/workflowService.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "oxlint": "^1.69.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2"
  }
}
